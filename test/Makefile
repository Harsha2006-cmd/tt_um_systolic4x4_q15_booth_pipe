# Makefile
# Cocotb simulation for the 4x4 Q15 systolic matrix multiplier
# with pipelined radix-4 Booth multipliers.

# ------------------------------------------------------------
# Simulator
# ------------------------------------------------------------

SIM ?= icarus
TOPLEVEL_LANG ?= verilog


# ------------------------------------------------------------
# RTL source files
#
# These paths are relative to test/
# Actual files are located in ../src/
# ------------------------------------------------------------

PROJECT_SOURCES = \
	tt_um_systolic4x4_q15_booth_pipe.v \
	systolic_array4x4_booth4_pipe.v \
	systolic_array4x4_1_booth4_pipe.v \
	pe_q15_booth4_pipe.v \
	radix4_booth_mult16_pipe.v \
	matrix_loader4x4.v \
	skew_delay.v


# ------------------------------------------------------------
# RTL simulation
# ------------------------------------------------------------

ifneq ($(GATES),yes)

SIM_BUILD = sim_build/rtl

VERILOG_SOURCES += $(addprefix $(PWD)/../src/,$(PROJECT_SOURCES))

COMPILE_ARGS += -DSIM
COMPILE_ARGS += -DFUNCTIONAL
COMPILE_ARGS += -DUSE_POWER_PINS


# ------------------------------------------------------------
# Gate-level simulation
# ------------------------------------------------------------

else

SIM_BUILD = sim_build/gl

COMPILE_ARGS += -DGL_TEST
COMPILE_ARGS += -DFUNCTIONAL
COMPILE_ARGS += -DUSE_POWER_PINS
COMPILE_ARGS += -DSIM
COMPILE_ARGS += -DUNIT_DELAY=\#1

VERILOG_SOURCES += $(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/verilog/primitives.v
VERILOG_SOURCES += $(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/verilog/sky130_fd_sc_hd.v

# Gate-level netlist generated by Tiny Tapeout
VERILOG_SOURCES += $(PWD)/gate_level_netlist.v

endif


# ------------------------------------------------------------
# Cocotb top level
# ------------------------------------------------------------
#
# IMPORTANT:
# If your test.py directly drives the Tiny Tapeout top module,
# use:
#
# TOPLEVEL = tt_um_systolic4x4_q15_booth_pipe
#
# If your test.py uses a separate Verilog wrapper called "tb",
# then TOPLEVEL = tb and that wrapper must also be included
# in VERILOG_SOURCES.
# ------------------------------------------------------------

TOPLEVEL = tt_um_systolic4x4_q15_booth_pipe


# ------------------------------------------------------------
# Python cocotb test
# ------------------------------------------------------------

MODULE = test


# ------------------------------------------------------------
# Cocotb simulation rules
# ------------------------------------------------------------

include $(shell cocotb-config --makefiles)/Makefile.sim
